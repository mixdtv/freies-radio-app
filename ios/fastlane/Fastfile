require "fileutils"
require "shellwords"

default_platform(:ios)

# Builds the Runner workspace (Flutter app already compiled by the workflow),
# signs it via App Store Connect API-key cloud signing (-allowProvisioningUpdates),
# and uploads to TestFlight. All auth comes from the API key — no Apple ID / 2FA.
#
# Required env (set by the workflow from repo secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8 file)

platform :ios do
  desc "Build and upload to TestFlight (API-key cloud signing)"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |var|
      UI.user_error!("#{var} is not set") if ENV[var].to_s.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
    )

    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", ENV["ASC_KEY_PATH"],
      "-authenticationKeyID", ENV["ASC_KEY_ID"],
      "-authenticationKeyIssuerID", ENV["ASC_ISSUER_ID"],
    ]

    # Archive only. gym still writes "method: app-store" into its generated
    # export plist (its export_method option rejects the Xcode 26 name
    # "app-store-connect"), and Xcode 26's exportArchive then dies with
    # "The data couldn't be read because it isn't in the correct format".
    # So the export below is done by hand with ExportOptions.plist.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      # Cloud signing: let Xcode create/download the distribution cert + profile
      # using the API key, so no certs need to live in the repo/CI.
      xcargs: auth_args.map { |arg| Shellwords.escape(arg) }.join(" "),
      skip_package_ipa: true,
      clean: true,
    )

    # Export into an empty directory, so the glob below cannot pick up an ipa
    # left over from an earlier run (CI is always clean, a dev machine is not).
    export_dir = File.expand_path("../build/export", __dir__)
    FileUtils.rm_rf(export_dir)
    FileUtils.mkdir_p(export_dir)

    sh(
      "xcodebuild", "-exportArchive",
      "-archivePath", lane_context[SharedValues::XCODEBUILD_ARCHIVE],
      "-exportPath", export_dir,
      "-exportOptionsPlist", File.expand_path("ExportOptions.plist", __dir__),
      *auth_args,
    )

    # xcodebuild names the ipa after the app, not the scheme ("Runner.ipa"),
    # so pick up whatever it wrote — but only if that is unambiguous.
    ipas = Dir.glob(File.join(export_dir, "*.ipa"))
    UI.user_error!("expected exactly one .ipa in #{export_dir}, found #{ipas.size}: " \
                   "#{ipas.map { |f| File.basename(f) }.join(', ')}") unless ipas.size == 1
    ipa_path = ipas.first
    UI.message("Exported ipa: #{ipa_path}")

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
